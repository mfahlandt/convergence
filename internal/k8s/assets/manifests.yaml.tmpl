---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ .Namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  salt: "{{ .StandinSalt }}"
{{- if eq .Provider "copilot" }}
---
apiVersion: v1
kind: Secret
metadata:
  name: convergence-copilot
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  GH_COPILOT_TOKEN: "{{ .CopilotToken }}"
{{- end }}
---
apiVersion: v1
# Rendered as a Secret (not a ConfigMap): provider=direct embeds API keys, and
# env interpolation of keys in agentgateway config could not be verified
# (--validate-only accepts "${VAR}" but cannot show it is expanded). Mounted
# the same way as a ConfigMap would be.
kind: Secret
metadata:
  name: agentgateway-config
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  config.yaml: |
    config:
      statsAddr: 0.0.0.0:15020
      connectionTerminationDeadline: 600s
      logging:
        format: json
    gateways:
      default:
        port: 3000
        extProc:
          conditional:
            - condition: 'request.method == "POST" && !request.path.endsWith("/embeddings")'
              host: "stand-in.{{ .Namespace }}.svc.cluster.local:9101"
              # failClosed by default: if Stand-In is down, requests are rejected
              # rather than sent upstream unscrubbed. --fail-open opts into passthrough.
              failureMode: {{ if .FailOpen }}failOpen{{ else }}failClosed{{ end }}
              processingOptions:
                requestHeaderMode: send
                responseHeaderMode: send
                requestBodyMode: fullDuplexStreamed
                responseBodyMode: fullDuplexStreamed
                requestTrailerMode: send
                responseTrailerMode: send
              policies:
                http: {requestTimeout: 5s}
    llm:
      policies:
        timeout:
          responseIdleTimeout: 120s
        extAuthz:
          conditional:
            - condition: 'request.method == "POST" && json(request.body).model in ["auto", "pinball"]'
              host: "pinball.{{ .Namespace }}.svc.cluster.local:9201"
              # allow (fail-open) on purpose: Pinball only picks a model tier; if it is
              # down the virtualModel falls back to its default target. No data-safety impact.
              failureMode: allow
              includeRequestBody: {maxRequestBytes: 16777216}
              includeRequestHeaders: [content-type, x-pinball-tier, x-pinball-min-tier, x-agw-caller]
              protocol:
                http:
                  path: '"/check"'
                  metadata:
                    model: 'json(response.body).model'
                    tier: 'json(response.body).tier'
                    reason: 'json(response.body).reason'
      providers:
{{- if eq .Provider "copilot" }}
        - name: copilot-completions
          provider:
            custom:
              providerOverride: openai
              formats:
                - {type: completions, path: /v1/chat/completions}
          params:
            baseUrl: http://copilot-api.{{ .Namespace }}.svc.cluster.local:4141/v1
            apiKey: dummy
{{- end }}
{{- if .UseOpenAI }}
        - name: openai-direct
          provider: openAI
          params:
{{- if .OpenAIBaseURL }}
            baseUrl: "{{ .OpenAIBaseURL }}"
{{- end }}
            apiKey: "{{ .OpenAIKey }}"
{{- end }}
{{- if .UseAnthropic }}
        - name: anthropic-direct
          provider: anthropic
          params:
            apiKey: "{{ .AnthropicKey }}"
{{- end }}
      virtualModels:
        - name: auto
          routing: &pinball_routing
            conditional:
              targets:
{{- range .Entries }}
                - {when: 'default(extauthz.model, "") == "{{ .Name }}"', model: pinball-{{ .Name }}}
{{- end }}
                - {model: pinball-{{ .Fallback }}}
        - name: pinball
          routing: *pinball_routing
        - name: light
          routing:
            conditional:
              targets:
                - {model: pinball-{{ .R.TierModel "light" }}}
        - name: standard
          routing:
            conditional:
              targets:
                - {model: pinball-{{ .R.TierModel "standard" }}}
        - name: heavy
          routing:
            conditional:
              targets:
                - {model: pinball-{{ .R.TierModel "heavy" }}}
      models:
{{- range .Entries }}
        - name: pinball-{{ .Name }}
          visibility: internal
          provider: {reference: {{ .Ref }}}
          params: {model: {{ .Upstream }}}
{{- end }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pinball-config
  namespace: {{ .Namespace }}
data:
  pinball.yaml: |
    # Schema of ghcr.io/jeefy/pinball:0.7.4 (heavy tier, thresholds, prompt_tokens).
    models:
{{- range .Entries }}
      {{ .Name }}: {prompt_tokens: {{ .PromptTokens }}}
{{- end }}
    tiers:
      light: [{{ .R.TierList "light" }}]
      standard: [{{ .R.TierList "standard" }}]
      heavy: [{{ .R.TierList "heavy" }}]
    thresholds:
      standard: {{ .R.Thresholds.Standard }}
      heavy: {{ .R.Thresholds.Heavy }}
{{- if .R.ScoringLines }}
    scoring:
{{- range .R.ScoringLines }}
      {{ . }}
{{- end }}
{{- end }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: agentgateway
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: agentgateway
  template:
    metadata:
      labels:
        app: agentgateway
    spec:
      # Service env links (e.g. PINBALL_PORT=tcp://...) collide with app env vars.
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: agentgateway
          image: {{ .Images.AgentGateway }}
          # args (not command): command would replace the image ENTRYPOINT.
          args: ["--file", "/etc/agentgateway/config.yaml"]
          ports:
            - containerPort: 3000
              name: http
            - containerPort: 15020
              name: stats
          readinessProbe:
            tcpSocket: {port: 3000}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            tcpSocket: {port: 3000}
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 1, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - name: config
              mountPath: /etc/agentgateway
              readOnly: true
      volumes:
        - name: config
          secret:
            secretName: agentgateway-config
---
apiVersion: v1
kind: Service
metadata:
  name: agentgateway
  namespace: {{ .Namespace }}
spec:
  selector:
    app: agentgateway
  ports:
    - name: http
      port: 3000
      targetPort: 3000
    - name: stats
      port: 15020
      targetPort: 15020
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: stand-in
  template:
    metadata:
      labels:
        app: stand-in
    spec:
      # Service env links (e.g. PINBALL_PORT=tcp://...) collide with app env vars.
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: stand-in
          image: {{ .Images.StandIn }}
          env:
            - name: STANDIN_MODE
              value: "enforce"
            - name: STANDIN_SALT
              valueFrom:
                secretKeyRef:
                  name: stand-in
                  key: salt
          ports:
            - containerPort: 9101
              name: grpc
            - containerPort: 9102
              name: metrics
          readinessProbe:
            tcpSocket: {port: 9101}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            tcpSocket: {port: 9101}
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 500m, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            seccompProfile: {type: RuntimeDefault}
---
apiVersion: v1
kind: Service
metadata:
  name: stand-in
  namespace: {{ .Namespace }}
spec:
  selector:
    app: stand-in
  ports:
    - name: grpc
      port: 9101
      targetPort: 9101
    - name: metrics
      port: 9102
      targetPort: 9102
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pinball
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: pinball
  template:
    metadata:
      labels:
        app: pinball
    spec:
      # Service env links (e.g. PINBALL_PORT=tcp://...) collide with app env vars.
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: pinball
          image: {{ .Images.Pinball }}
          env:
            - name: PINBALL_CONFIG
              value: /etc/pinball/pinball.yaml
{{- if .OptimizerDSN }}
            - name: PINBALL_OVERLAY_PATH
              value: /var/lib/pinball/overlay.yaml
{{- end }}
          ports:
            - containerPort: 9201
              name: http
          readinessProbe:
            tcpSocket: {port: 9201}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            tcpSocket: {port: 9201}
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 500m, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - name: config
              mountPath: /etc/pinball
              readOnly: true
{{- if .OptimizerDSN }}
            - name: overlay
              mountPath: /var/lib/pinball
              readOnly: true
{{- end }}
      volumes:
        - name: config
          configMap:
            name: pinball-config
{{- if .OptimizerDSN }}
        - name: overlay
          persistentVolumeClaim:
            claimName: pinball-overlay
            readOnly: true
{{- end }}
---
apiVersion: v1
kind: Service
metadata:
  name: pinball
  namespace: {{ .Namespace }}
spec:
  selector:
    app: pinball
  ports:
    - name: http
      port: 9201
      targetPort: 9201
{{- if .OptimizerDSN }}
---
apiVersion: v1
kind: Secret
metadata:
  name: pinball-optimizer-db
  namespace: {{ .Namespace }}
type: Opaque
stringData:
  dsn: {{ printf "%q" .OptimizerDSN }}
---
# NOTE: ReadWriteOnce limits pinball (readers) and the optimizer (writer) to
# the same node, so pinball replicas effectively run on a single node. Use an
# RWX-capable storage class and edit accessModes if you need to spread them.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pinball-overlay
  namespace: {{ .Namespace }}
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 100Mi
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: pinball-optimize
  namespace: {{ .Namespace }}
spec:
  schedule: "{{ .OptSchedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        spec:
          restartPolicy: Never
          enableServiceLinks: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            fsGroup: 1000
            seccompProfile: {type: RuntimeDefault}
          containers:
            - name: optimize
              image: {{ .Images.Pinball }}
              command: ["pinball-optimize", "run"]
              env:
                - name: PINBALL_CONFIG
                  value: /etc/pinball/pinball.yaml
                - name: PINBALL_OVERLAY_PATH
                  value: /var/lib/pinball/overlay.yaml
                - name: PINBALL_OPT_DB_DSN
                  valueFrom:
                    secretKeyRef:
                      name: pinball-optimizer-db
                      key: dsn
                - name: PINBALL_OPT_GATEWAY_URL
                  value: "http://agentgateway.{{ .Namespace }}.svc.cluster.local:3000"
                - name: PINBALL_OPT_MODEL_PREFIX
                  value: "opt-"
                - name: PINBALL_OPT_BUDGET_USD
                  value: "10.0"
              resources:
                requests: {cpu: 50m, memory: 128Mi}
                limits: {cpu: 500m, memory: 512Mi}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: {drop: ["ALL"]}
                seccompProfile: {type: RuntimeDefault}
              volumeMounts:
                - name: config
                  mountPath: /etc/pinball
                  readOnly: true
                - name: overlay
                  mountPath: /var/lib/pinball
          volumes:
            - name: config
              configMap:
                name: pinball-config
            - name: overlay
              persistentVolumeClaim:
                claimName: pinball-overlay
{{- end }}
{{- if eq .Provider "copilot" }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: copilot-api-idle-timeout
  namespace: {{ .Namespace }}
data:
  idle-timeout.js: |
    // Rendered by convergence. Bun.serve defaults idleTimeout to 10s, which cuts
    // streamed completions whenever Copilot is silent for >10s (long tool calls,
    // large contexts): copilot-api logs "request timed out after 10 seconds" and
    // agentgateway waits on a dead upstream. copilot-api v0.7.0 has no flag for it
    // (upstream: ericc-ch/copilot-api#153, #268), so preload this shim to disable
    // the idle timeout unless the caller set one explicitly.
    const serve = Bun.serve.bind(Bun);
    Bun.serve = (options) => serve({ ...options, idleTimeout: options.idleTimeout ?? 0 });
  bunfig.toml: |
    # Rendered by convergence: preload the idle-timeout shim (see idle-timeout.js).
    preload = ["/etc/copilot-api/idle-timeout.js"]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: copilot-api
  namespace: {{ .Namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: copilot-api
  template:
    metadata:
      labels:
        app: copilot-api
    spec:
      enableServiceLinks: false
      containers:
        - name: copilot-api
          # v0.1.25 does not exist upstream; image runs as root so no runAsNonRoot.
          image: {{ .Images.CopilotAPI }}
          env:
            - name: GH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: convergence-copilot
                  key: GH_COPILOT_TOKEN
          ports:
            - containerPort: 4141
              name: http
          readinessProbe:
            tcpSocket: {port: 4141}
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            tcpSocket: {port: 4141}
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 500m, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            seccompProfile: {type: RuntimeDefault}
          # Disable Bun's 10s idleTimeout, which cuts long streamed completions.
          volumeMounts:
            - name: idle-timeout
              mountPath: /etc/copilot-api/idle-timeout.js
              subPath: idle-timeout.js
              readOnly: true
            - name: idle-timeout
              mountPath: /app/bunfig.toml
              subPath: bunfig.toml
              readOnly: true
      volumes:
        - name: idle-timeout
          configMap:
            name: copilot-api-idle-timeout
---
apiVersion: v1
kind: Service
metadata:
  name: copilot-api
  namespace: {{ .Namespace }}
spec:
  selector:
    app: copilot-api
  ports:
    - name: http
      port: 4141
      targetPort: 4141
{{- end }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-ingress
  namespace: {{ .Namespace }}
spec:
  podSelector: {}
  policyTypes: [Ingress]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-gateway-to-stand-in
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels:
      app: stand-in
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app: agentgateway}}
      ports:
        - {protocol: TCP, port: 9101}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-gateway-to-pinball
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels:
      app: pinball
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app: agentgateway}}
      ports:
        - {protocol: TCP, port: 9201}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-cluster-to-gateway
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels:
      app: agentgateway
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {}
      ports:
        - {protocol: TCP, port: 3000}
{{- if eq .Provider "copilot" }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-gateway-to-copilot-api
  namespace: {{ .Namespace }}
spec:
  podSelector:
    matchLabels:
      app: copilot-api
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {app: agentgateway}}
      ports:
        - {protocol: TCP, port: 4141}
{{- end }}
{{- if .IngressHost }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: agentgateway
  namespace: {{ .Namespace }}
spec:
  rules:
    - host: {{ .IngressHost }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: agentgateway
                port:
                  number: 3000
{{- end }}
{{- if .EnablePDB }}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: agentgateway-pdb
  namespace: {{ .Namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: agentgateway
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: stand-in-pdb
  namespace: {{ .Namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: stand-in
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: pinball-pdb
  namespace: {{ .Namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: pinball
{{- end }}
